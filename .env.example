# 식약처 식품영양성분DB Open API 인증키
# 발급: https://www.data.go.kr/data/15127578/openapi.do 에서 "활용신청" (공공데이터포털 - foodsafetykorea.go.kr 자체 검색 아님, 주의)
FOODSAFETY_API_KEY=

# 네이버쇼핑 검색 API - KR 제품 실시간 가격 조회용 (lib/liveData.ts에 연동 코드 있음, 키만 채우면 동작)
# 발급: https://developers.naver.com/apps/#/register 에서 애플리케이션 등록 (검색 API 선택)
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=

# 楽天市場 상품검색 API - JP 제품 실시간 가격 조회용 (아직 코드 연동 안 됨, JP 카테고리 제품도 1개뿐)
RAKUTEN_APP_ID=
