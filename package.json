{
  "name": "mart-compare-mcp",
  "version": "0.1.0",
  "description": "마트 제품 비교/추천 MCP 서버 - 스펙/인증은 큐레이션 DB, 가격/리뷰는 실시간 조회 (하이브리드)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && shx mkdir -p dist/data/products && shx cp src/data/products/*.json dist/data/products/",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "ingest": "tsx src/scripts/ingestFoodSafetyKorea.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "shx": "^0.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
